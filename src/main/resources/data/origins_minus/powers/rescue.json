{
	"type": "origins:active_self",
	"entity_action": {
		"type": "origins:raycast",
		"distance": 20,
		"block": false,
		"entity": true,
		"fluid_handling": "none",
		"command_along_ray": "particle minecraft:block{block_state:{Name:'minecraft:iron_bars'}} ~ ~ ~ 0 0 0 0 1",
		"before_action": {
			"type": "origins:swing_hand",
			"hand": "MAIN_HAND"
		},
		"hit_action": [
			{
				"type": "origins:play_sound",
				"sound": "minecraft:block.chain.break",
				"volume": 0.4,
				"pitch": 0.9
			},
			{
				"type": "origins:play_sound",
				"sound": "minecraft:block.iron_door.close",
				"volume": 0.4,
				"pitch": 2.0
			},
			{
				"type": "origins:play_sound",
				"sound": "minecraft:entity.fishing_bobber.retrieve",
				"volume": 1.0,
				"pitch": 0.6
			}
		],
		"miss_action": [
			{
				"type": "origins:play_sound",
				"sound": "minecraft:block.chain.break",
				"volume": 0.3,
				"pitch": 0.7
			},
			{
				"type": "origins:play_sound",
				"sound": "minecraft:block.fire.extinguish",
				"volume": 0.15,
				"pitch": 2.0
			},
			{
				"type": "origins:delay",
				"ticks": 4,
				"action": {
					"type": "origins:change_resource",
					"resource": "*:*",
					"change": 40
				}
			}
		],
		"bientity_action": [
			{
				"type": "origins:add_velocity",
				"z": -2

			},
			{
				"type": "origins:target_action",
				"action": [
					{
						"type": "origins:add_velocity",
						"y": 0.4
					},
					{
						"type": "origins:set_fall_distance",
						"fall_distance": 0
					},
					{
						"type": "origins:apply_effect",
						"effect": {
							"id": "minecraft:slowness",
							"duration": 30,
							"amplifier": 0,
							"ambient": true,
							"show_particles": true,
							"show_icon": false
						}
					}
				]
			}
		],
		"match_bientity_condition": {
			"type": "origins:target_condition",
			"condition": [
				{
					"type": "origins:living"
				}
			]
		}
	},
	"cooldown": 40,
	"hud_render": {
		"should_render": true,
		"inverted": true,
		"sprite_location": "origins:textures/gui/community/spiderkolo/resource_bar_02.png",
		"bar_index": 1
	}
}
