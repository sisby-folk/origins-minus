			"type": "origins:nothing"
		},
		"key": "key.jump"
	},
	"size_callbacks": {
		"type": "origins:action_on_callback",
		"entity_action_gained": {
			"type": "origins:and",
			"actions": [
				{
					"type": "origins:execute_command",
					"command": "scale persist set pehkui:flight true"
				},
				{
					"type": "origins:execute_command",
					"command": "scale delay set pehkui:flight 0"
				},
				{
					"type": "origins:execute_command",
					"command": "scale set pehkui:flight 0"
				}
			]
		},
		"entity_action_respawned": {
			"type": "origins:and",
			"actions": [
				{
					"type": "origins:execute_command",
					"command": "scale delay set pehkui:flight 0"
				},
				{
					"type": "origins:execute_command",
					"command": "scale set pehkui:flight 0"
				}
			]
		},
		"entity_action_lost": {
			"type": "origins:and",
			"actions": [
				{
					"type": "origins:execute_command",
					"command": "scale reset pehkui:flight @s"
				},
				{
					"type": "origins:execute_command",
					"command": "scale delay reset pehkui:flight @s"
				},
				{
					"type": "origins:execute_command",
					"command": "scale persist set pehkui:flight false"
				}
			]
		}
	},
	"flight": {
		"condition": {
			"type": "origins:and",
			"conditions": [
				{
					"type": "origins:exposed_to_sky",
					"inverted": true
				},
				{
					"type": "origins:fluid_height",
					"fluid": "minecraft:water",
					"comparison": "<",
					"compare_to": 1.1
				}
			]
		},
		"type": "origins:creative_flight"
	},
	"raise": {
		"type": "origins:active_self",
